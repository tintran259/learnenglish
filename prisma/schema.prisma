generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  userVocabulary UserVocabulary[]
  notes          Note[]
  settings       UserSettings?
  dailyReviews   DailyReview[]
  createdAt      DateTime        @default(now())
}

model UserSettings {
  id             String @id @default(cuid())
  userId         String @unique
  dailyTarget    Int    @default(10)
  currentStreak  Int    @default(0)
  bestStreak     Int    @default(0)
  lastActiveDate String @default("")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyReview {
  id       String @id @default(cuid())
  userId   String
  date     String
  reviewed Int    @default(0)
  correct  Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ── Vocabulary ────────────────────────────────────────────────────────────────

// Global word data — shared across all users.
// IPA, audio, and API examples are fetched once and reused.
model Word {
  id         String          @id @default(cuid())
  word       String          @unique
  ipa        String          @default("")
  audioUrl   String          @default("")
  audioUrlUk String          @default("")
  examples   String          @default("[]") // JSON array — from dictionary API
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  userWords  UserVocabulary[]
}

// Per-user vocabulary entry. Links a User to a global Word.
model UserVocabulary {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  meaning        String                        // user's personal translation
  userExamples   String    @default("")        // personal examples (newline-separated), overrides Word.examples
  reviewCount    Int       @default(0)
  correctCount   Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

// ── Notes ─────────────────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  content   String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
